<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>WordGuard.Client.App</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ApplicationIcon>WordGuard.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WordGuard.Client\WordGuard.Client.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
  </ItemGroup>

  <ItemGroup>
    <None Include="web\**\*" CopyToOutputDirectory="PreserveNewest" />
    <None Include="wordguard.settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="alert.wav" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
